# Copy this file to .env in the same folder (same level as package.json /
# server.js) and fill in your own values. .env is already listed in
# .gitignore, so it will never get committed - only this .env.example
# template (with no real secrets) is meant to be checked into git.
#
# server.js loads .env automatically via dotenv - no other setup needed for
# local development. On Render, don't create a .env file at all; instead set
# these same keys as real environment variables in the Render dashboard (see
# render.yaml, which already has placeholders for them).

# TURN credentials for voice chat, from https://www.metered.ca/stun-turn
# (free tier: 500MB relay/month, no credit card). Leave both blank to run on
# the free public fallback TURN server instead - fine for local testing.
METERED_APP_NAME=
METERED_API_KEY=

# Optional - hours to cache TURN credentials before refetching. Defaults to
# 6 if not set.
METERED_CACHE_HOURS=6
